@-moz-document url-prefix("https://your.shared.project.link.here") {

/* make background state black and give an fade */
html,
body,
#app { background-color: #1e1e1e !important; }
body { opacity: 0; transition: opacity 0.6s ease-in-out !important; }

/* efficient yellow blinking using a pseudo-element (animates opacity only) */
@keyframes yellow-blnk {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

/* disable logo because it use many space */
.logo { display: none !important; }

/* make overdue and high priority blinking as set above, note: class .is-overdue need set by tampermonkey */
.is-overdue,
.high-priority {
  font-weight: bold !important;
  position: relative !important;
}

.is-overdue::after,
.high-priority::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  background: #ffeb3b !important;
  opacity: 0 !important;
  pointer-events: none !important;
  z-index: 0 !important;
  animation: yellow-blnk 2.5s infinite !important;
  will-change: opacity !important;
}

/* ensure text/content sits above the pseudo-element */
.is-overdue > *,
.high-priority > * {
  position: relative !important;
  z-index: 1 !important;
}

@media (prefers-reduced-motion: reduce) {
  .is-overdue::after,
  .high-priority::after { animation: none !important; opacity: 0 !important; }
}

/* get full width */
[class*="container"],
[class*="wrapper"],
[class*="layout"],
[class*="list"],
[class*="view"],
[class*="grid"]
{
  width: 100% !important;
  max-width: 100% !important;
}

/* make progressbar smaller */
[class*="progress"] { width: 150px !important; max-width: none !important; min-width: 0px !important; flex-shrink: 0 !important; flex-grow: 0 !important; }
}
