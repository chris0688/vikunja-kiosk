@-moz-document url-prefix("https://your.shared.project.link.here") {

/* make background state black and give an fade */
html,
body,
#app { background-color: #1e1e1e !important; }
body { opacity: 0; transition: opacity 0.6s ease-in-out !important; }

/* disable logo because it use many space */
.logo { display: none !important; }

/* make overdue and high priority blink reliably */
.is-overdue,
.high-priority {
  position: relative !important;
  display: inline-block !important;
  padding: 0 0.15em !important;
  font-weight: bold !important;
  background: rgba(255, 235, 59, 0.9) !important;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08) !important;
  animation: yellow-blnk 2.5s ease-in-out infinite !important;
}

@keyframes yellow-blnk {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

@media (prefers-reduced-motion: reduce) {
  .is-overdue,
  .high-priority { animation: none !important; opacity: 1 !important; }
}

/* get full width */
[class*="container"],
[class*="wrapper"],
[class*="layout"],
[class*="list"],
[class*="view"],
[class*="grid"]
{
  width: 100% !important;
  max-width: 100% !important;
}

/* make progressbar smaller */
[class*="progress"] { width: 150px !important; max-width: none !important; min-width: 0px !important; flex-shrink: 0 !important; flex-grow: 0 !important; }
}
